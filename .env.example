AUTH_USER=owntracks
AUTH_PASS=replace-with-a-long-random-secret

# Loopback publication for direct access or a host-based reverse proxy.
LOCATION_BIND_ADDRESS=127.0.0.1
LOCATION_PORT=8080

# Existing Docker network shared with an optional MCP client.
AGENT_NETWORK=agent

# Optional compose.traefik.yml overlay.
LOCATION_HOST=location.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
